            type === BLOCK_BED) return 2;
        if (type === BLOCK_LEAVES || type === ITEM_WOOD_PICK ||
            type === ITEM_WOOD_AXE || type === ITEM_WOOD_SWORD || type === ITEM_WOOD_SHOVEL ||
            type === ITEM_WOOD_HOE || type === BLOCK_CAMPFIRE) return 1;
        return 0;
    }

    function findSmelt(type) {
        for (let i = 0; i < SMELT_RECIPES.length; i++) {
            if (SMELT_RECIPES[i].in === type) return SMELT_RECIPES[i];
