    document.querySelectorAll('.book-cats button').forEach(function (btn) {
        const go = function (e) {
            e.preventDefault();
            e.stopPropagation();
            bookCat = btn.getAttribute('data-cat');
            document.querySelectorAll('.book-cats button').forEach(function (b) { b.className = (b === btn) ? 'on' : ''; });
            renderCraftBook();
        };
        btn.addEventListener('click', go);
        btn.addEventListener('touchstart', go, { passive: false });
    });
    const searchEl = document.getElementById('book-search');
    if (searchEl) {
        searchEl.addEventListener('input', function () {
            bookQuery = searchEl.value || '';
            renderCraftBook();
        });
    }

    let lastInvUiTap = 0;
    function invUiTap(fn) {
        return function (e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            const now = Date.now();
            if (now - lastInvUiTap < 280) return;
            lastInvUiTap = now;
            fn();
        };
    }

    function moveInvCursorFloat(x, y) {
        const flt = document.getElementById('inv-cursor-float');
        if (!flt || isSlotEmpty(cursorStack)) return;
        flt.style.left = x + 'px';
        flt.style.top = y + 'px';
        flt.style.display = 'block';
    }

    invOverlay.addEventListener('touchstart', (e) => {
        e.stopPropagation();
        if (e.target === invOverlay) {
            e.preventDefault();
            setInventoryOpen(false);
            return;
        }
        const furn = e.target.closest('[data-furnace]');
        if (furn) {
            e.preventDefault();
            handleFurnaceSlotTap(furn.getAttribute('data-furnace'));
            if (e.changedTouches && e.changedTouches[0]) moveInvCursorFloat(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
            return;
        }
        const out = e.target.closest('.craft-out');
        if (out) {
            e.preventDefault();
            handleCraftOutput(parseInt(out.dataset.out, 10));
            if (e.changedTouches && e.changedTouches[0]) moveInvCursorFloat(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
            return;
        }
        const cs = e.target.closest('.craft-slot');
        if (cs && cs.dataset.craft) {
            e.preventDefault();
            const parts = cs.dataset.craft.split(':');
            handleCraftSlotTap(parseInt(parts[0], 10), parseInt(parts[1], 10));
            if (e.changedTouches && e.changedTouches[0]) moveInvCursorFloat(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
            return;
        }
        const slot = e.target.closest('.inv-slot');
        if (slot) {
            e.preventDefault();
            handleInvSlotTap(parseInt(slot.dataset.index, 10));
            if (e.changedTouches && e.changedTouches[0]) {
                moveInvCursorFloat(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
            }
        }
    }, { passive: false });
    invOverlay.addEventListener('touchmove', (e) => {
        if (e.changedTouches && e.changedTouches[0]) {
            moveInvCursorFloat(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
        }
    }, { passive: true });
    invOverlay.addEventListener('click', (e) => {
        if (e.target === invOverlay) {
            setInventoryOpen(false);
            return;
        }
        const furn = e.target.closest('[data-furnace]');
        if (furn) { handleFurnaceSlotTap(furn.getAttribute('data-furnace')); moveInvCursorFloat(e.clientX, e.clientY); return; }
        const out = e.target.closest('.craft-out');
        if (out) { handleCraftOutput(parseInt(out.dataset.out, 10)); moveInvCursorFloat(e.clientX, e.clientY); return; }
        const cs = e.target.closest('.craft-slot');
        if (cs && cs.dataset.craft) {
            const parts = cs.dataset.craft.split(':');
            handleCraftSlotTap(parseInt(parts[0], 10), parseInt(parts[1], 10));
            moveInvCursorFloat(e.clientX, e.clientY);
            return;
        }
        const slot = e.target.closest('.inv-slot');
        if (!slot) return;
        if (e.detail === 0) return;
        handleInvSlotTap(parseInt(slot.dataset.index, 10));
        moveInvCursorFloat(e.clientX, e.clientY);
    });
    invOverlay.addEventListener('mousemove', (e) => {
        moveInvCursorFloat(e.clientX, e.clientY);
    });

    document.getElementById('inv-btn-split').addEventListener('touchstart', invUiTap(splitHeldStack), { passive: false });
    document.getElementById('inv-btn-split').addEventListener('click', invUiTap(splitHeldStack));
    document.getElementById('inv-btn-drop1').addEventListener('touchstart', invUiTap(function () { dropFromInventory(-1, 1); }), { passive: false });
    document.getElementById('inv-btn-drop1').addEventListener('click', invUiTap(function () { dropFromInventory(-1, 1); }));
    document.getElementById('inv-btn-dropall').addEventListener('touchstart', invUiTap(function () {
        dropFromInventory(-1, cursorStack.count);
    }), { passive: false });
    document.getElementById('inv-btn-dropall').addEventListener('click', invUiTap(function () {
        dropFromInventory(-1, cursorStack.count);
    }));
    document.getElementById('inv-btn-eat').addEventListener('touchstart', invUiTap(function () { eatFromInventory(); }), { passive: false });
    document.getElementById('inv-btn-eat').addEventListener('click', invUiTap(function () { eatFromInventory(); }));
    document.getElementById('inv-btn-equip').addEventListener('touchstart', invUiTap(moveHeldToHotbar), { passive: false });
    document.getElementById('inv-btn-equip').addEventListener('click', invUiTap(moveHeldToHotbar));
    document.getElementById('inv-btn-stack').addEventListener('touchstart', invUiTap(compactInventory), { passive: false });
    document.getElementById('inv-btn-stack').addEventListener('click', invUiTap(compactInventory));
    document.addEventListener('fullscreenchange', updateFullscreenIcon);
    document.addEventListener('webkitfullscreenchange', updateFullscreenIcon);
    document.addEventListener('MSFullscreenChange', updateFullscreenIcon);

    // --- 13. GAME LOOP ---
    let lastTime = performance.now();
    let frameCount = 0, fpsTimer = 0;
    const statsEl = document.getElementById('stats').firstElementChild;

    updateInfiniteChunks(player.pos.x, player.pos.z);
    placePlayerAtSpawn();

    function trySpawnMobNear(type, originX, originZ, minR, maxR) {
        for (let r = minR; r <= maxR; r++) {
            for (let dx = -r; dx <= r; dx++) {
                for (let dz = -r; dz <= r; dz++) {
                    if (Math.max(Math.abs(dx), Math.abs(dz)) !== r) continue;
                    const sx = Math.floor(originX) + dx;
                    const sz = Math.floor(originZ) + dz;
                    const sy = getSurfaceY(sx, sz);
                    const ground = getBlock(sx, sy - 1, sz);
                    const here = getBlock(sx, sy, sz);
                    if ((ground === BLOCK_GRASS || ground === BLOCK_SAND || ground === BLOCK_DIRT) && !isOpaque(here)) {
                        mobs.push(new Mob(type, sx + 0.5, sy, sz + 0.5));
                        return true;
                    }
                }
            }
        }
        return false;
    }

    trySpawnMobNear('chicken', player.pos.x, player.pos.z, 3, 10);
    trySpawnMobNear('chicken', player.pos.x, player.pos.z, 4, 12);
    trySpawnMobNear('pig', player.pos.x, player.pos.z, 4, 12);
    trySpawnMobNear('sheep', player.pos.x, player.pos.z, 4, 12);

    function animate(currentTime) {
        requestAnimationFrame(animate);

        const dt = Math.min((currentTime - lastTime) / 1000, 0.05);
        lastTime = currentTime;

        StarShader.uniforms.uTime.value = currentTime * 0.001;

        updateDayNightCycle(dt);
        updateDroppedItems(dt);
        updateMobsManager(dt);

        if (cloudsMesh) {
            const windSpeed = 0.8;
            const cloudSpan = CLOUD_MAP_SIZE * CLOUD_CELL_SIZE;
            const cloudOffset = (currentTime * 0.001 * windSpeed) % cloudSpan;
            cloudsMesh.position.x = player.pos.x - cloudSpan / 2 + cloudOffset;
            cloudsMesh.position.z = player.pos.z - cloudSpan / 2;
        }

        frameCount++;
        fpsTimer += dt;
        if (fpsTimer >= 1.0) {
            statsEl.innerText = `FPS: ${frameCount} | Mobs: ${mobs.length}`;
            frameCount = 0;
            fpsTimer = 0;
        }

        const currentSpeed = player.isInWater ? 3.4 : 5.0;
        const forwardX = -Math.sin(player.yaw);
        const forwardZ = -Math.cos(player.yaw);
        const rightX = Math.cos(player.yaw);
        const rightZ = -Math.sin(player.yaw);

        player.vel.x = (forwardX * moveInput.y + rightX * moveInput.x) * currentSpeed;
        player.vel.z = (forwardZ * moveInput.y + rightZ * moveInput.x) * currentSpeed;

        updatePhysics(dt);
        updateInfiniteChunks(player.pos.x, player.pos.z);

        const hit = raycastVoxel();
        if (hit.hit && !hit.isMob) {
            highlightBox.position.set(hit.block.x + 0.5, hit.block.y + 0.5, hit.block.z + 0.5);
            highlightBox.visible = true;
        } else {
            highlightBox.visible = false;
        }

        renderer.render(scene, camera);
    }

    requestAnimationFrame(animate);
    </script>
