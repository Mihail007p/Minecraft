                furnaceOut = emptySlot();
            } else if (cursorStack.type === furnaceOut.type && cursorStack.count < STACK_SIZE) {
                const mv = Math.min(furnaceOut.count, STACK_SIZE - cursorStack.count);
                cursorStack.count += mv;
                furnaceOut.count -= mv;
                if (furnaceOut.count <= 0) furnaceOut = emptySlot();
