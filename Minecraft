<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Minecraft Classic Water - Tecno Pova Neo 3</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
        }
        #inv-overlay, #inv-panel, #recipe-book, #book-grid, #book-scroll-wrap {
            touch-action: pan-y !important;
            -webkit-overflow-scrolling: touch;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        #game-canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 14px;
            height: 14px;
            pointer-events: none;
            z-index: 10;
        }
        #crosshair::before, #crosshair::after {
            content: '';
            position: absolute;
            background: rgba(255, 255, 255, 0.85);
            box-shadow: 0 0 2px rgba(0, 0, 0, 0.8);
        }
        #crosshair::before { top: 6px; left: 0; width: 14px; height: 2px; }
        #crosshair::after { top: 0; left: 6px; width: 2px; height: 14px; }

        #damage-flash {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 0, 0, 0.45);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s ease-out;
            z-index: 25;
        }

        #underwater-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(18, 55, 120, 0.45);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 5;
        }

        /* HUD Жизни и Кислорода */
        #hud {
            position: absolute;
            bottom: 74px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            justify-content: space-between;
            width: 300px;
            pointer-events: none;
            z-index: 20;
        }
        .hud-bar {
            display: flex;
            gap: 2px;
        }
        .heart, .bubble {
            width: 12px;
            height: 12px;
            display: inline-block;
        }
        .heart {
            background-color: #e74c3c;
            clip-path: polygon(50% 0%, 100% 35%, 82% 100%, 50% 80%, 18% 100%, 0% 35%);
            box-shadow: 0 0 2px #000;
        }
        .heart.half {
            background: linear-gradient(to right, #e74c3c 50%, rgba(0,0,0,0.4) 50%);
        }
        .heart.empty {
            background-color: rgba(0, 0, 0, 0.5);
            border: 1px solid #777;
        }
        .bubble {
            background: radial-gradient(circle at 30% 30%, #fff, #3498db);
            border-radius: 50%;
            border: 1px solid #1d6fa5;
        }
        .bubble.empty { opacity: 0; }

        /* Сенсорный UI */
        #ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 15;
        }
        
        #joystick-zone {
            position: absolute;
            bottom: 30px;
            left: 30px;
            width: 130px;
            height: 130px;
            background: rgba(255, 255, 255, 0.12);
            border: 2px solid rgba(255, 255, 255, 0.25);
            border-radius: 50%;
            pointer-events: auto;
        }
        #joystick-knob {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 50px;
            height: 50px;
            margin: -25px 0 0 -25px;
            background: rgba(255, 255, 255, 0.6);
            border-radius: 50%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
        }

        .btn-group {
            position: absolute;
            bottom: 30px;
            right: 25px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            pointer-events: auto;
        }
        .action-btn {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.35);
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 12px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
            text-transform: uppercase;
        }
        .action-btn:active {
            background: rgba(255, 255, 255, 0.4);
            transform: scale(0.92);
        }
        #btn-jump { background: rgba(52, 152, 219, 0.55); }
        #btn-break { background: rgba(231, 76, 60, 0.55); }
        #btn-place { background: rgba(46, 204, 113, 0.55); }

        #hotbar {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 5px;
            background: rgba(0, 0, 0, 0.7);
            padding: 5px;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            pointer-events: auto;
        }
        .slot {
            position: relative;
            width: 44px;
            height: 44px;
            background: rgba(255, 255, 255, 0.08);
            border: 2px solid transparent;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            color: white;
            text-align: center;
            font-weight: bold;
        }
        .slot.active {
            border-color: #f1c40f;
            background: rgba(241, 196, 15, 0.25);
        }
        .count-badge {
            position: absolute;
            bottom: 1px;
            right: 2px;
            font-size: 11px;
            color: #fff;
            text-shadow: 1px 1px 0 #000, -1px 0 0 #000, 0 -1px 0 #000;
            font-family: monospace;
            font-weight: 900;
            pointer-events: none;
        }
        .item-icon {
            width: 28px;
            height: 28px;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            pointer-events: none;
            display: block;
        }
        .slot .item-icon { width: 30px; height: 30px; }
        .inv-slot .item-icon, .craft-slot .item-icon { width: 26px; height: 26px; }
        .craft-out .item-icon { width: 32px; height: 32px; }
        .book-cell .item-icon { width: 18px; height: 18px; position: absolute; top: 3px; left: 50%; transform: translateX(-50%); }

        #stats {
            position: absolute;
            top: 10px;
            left: 10px;
            color: #fff;
            font-size: 12px;
            background: rgba(0,0,0,0.55);
            padding: 5px 9px;
            border-radius: 5px;
            font-family: monospace;
            pointer-events: none;
            z-index: 20;
            line-height: 1.4;
        }

        #death-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(139, 0, 0, 0.82);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
            z-index: 100;
        }
        #death-screen h1 {
            color: #fff;
            font-size: 32px;
            text-shadow: 2px 2px 5px #000;
        }
        #respawn-btn {
            padding: 14px 28px;
            background: #fff;
            color: #8b0000;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
        }

        #btn-fullscreen {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 44px;
            height: 44px;
            border-radius: 8px;
            border: 2px solid rgba(255, 255, 255, 0.25);
            background: rgba(0, 0, 0, 0.55);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: auto;
            z-index: 20;
            backdrop-filter: blur(4px);
        }
        #btn-fullscreen:active {
            background: rgba(255, 255, 255, 0.35);
            transform: scale(0.92);
        }
        #btn-fullscreen svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: #fff;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        #btn-inventory {
            position: absolute;
            top: 62px;
            right: 10px;
            width: 44px;
            height: 44px;
            border-radius: 8px;
            border: 2px solid rgba(255, 255, 255, 0.25);
            background: rgba(0, 0, 0, 0.55);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: auto;
            z-index: 20;
            backdrop-filter: blur(4px);
        }
        #btn-inventory:active { background: rgba(255, 255, 255, 0.35); transform: scale(0.92); }
        #btn-inventory svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: #fff;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        #inv-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.62);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 80;
            pointer-events: auto;
        }
        #inv-panel {
            width: min(420px, 96vw);
            max-height: 88vh;
            overflow-x: hidden;
            overflow-y: scroll;
            background: #c6c6c6;
            border: 3px solid #000;
            border-radius: 0;
            padding: 10px 10px 12px;
            color: #3f3f3f;
            box-shadow: 4px 4px 0 rgba(0,0,0,0.45);
            font-family: "Minecraft", "Courier New", monospace;
        }
        #inv-panel h2 {
            font-size: 14px;
            text-align: left;
            margin: 0 0 6px 4px;
            letter-spacing: 0;
            color: #404040;
            text-shadow: none;
        }
        #inv-panel input, #inv-panel button, #inv-panel .inv-slot,
        #inv-panel .craft-slot, #inv-panel .craft-out, #inv-panel .book-cell {
            touch-action: pan-y manipulation;
        }
        #book-search {
            user-select: text;
            -webkit-user-select: text;
        }
        #inv-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 4px;
            margin-bottom: 8px;
        }
        #inv-tabs button {
            padding: 7px;
            border-radius: 0;
            border: 2px solid #373737;
            background: #8b8b8b;
            color: #fff;
            font-weight: bold;
            font-size: 12px;
            box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #555;
        }
        #inv-tabs button.on {
            background: #c6c6c6;
            color: #222;
            border-color: #000;
        }
        #inv-shell {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: flex-start;
        }
        #recipe-book {
            display: none;
            width: 100%;
            background: #c6c6c6;
            border: 2px solid #373737;
            padding: 6px;
        }
        #recipe-book.open { display: block; }
        .book-top {
            display: flex;
            gap: 4px;
            margin-bottom: 5px;
        }
        #book-search {
            flex: 1;
            border: 2px solid #373737;
            background: #fff;
            color: #111;
            font-size: 12px;
            padding: 4px 6px;
        }
        #book-filter {
            border: 2px solid #373737;
            background: #8b8b8b;
            color: #fff;
            font-size: 11px;
            font-weight: bold;
            padding: 4px 6px;
            min-width: 92px;
        }
        .book-cats {
            display: flex;
            gap: 3px;
            margin-bottom: 5px;
        }
        .book-cats button {
            flex: 1;
            padding: 5px 2px;
            border: 2px solid #373737;
            background: #8b8b8b;
            color: #fff;
            font-size: 10px;
            font-weight: bold;
        }
        .book-cats button.on { background: #5a8f3a; }
        .book-cell .can-n {
            position: absolute;
            top: 1px;
            right: 2px;
            font-size: 9px;
            color: #c8ffb0;
            text-shadow: 1px 1px 0 #000;
            z-index: 2;
        }
        #book-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 3px;
            height: min(42vh, 250px);
            min-height: 160px;
            overflow-x: hidden;
            overflow-y: scroll;
            touch-action: pan-y;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior: contain;
            padding-right: 4px;
            padding-bottom: 10px;
        }
        #book-grid::-webkit-scrollbar {
            width: 10px;
        }
        #book-grid::-webkit-scrollbar-track {
            background: #8b8b8b;
            box-shadow: inset 1px 1px 0 #373737;
        }
        #book-grid::-webkit-scrollbar-thumb {
            background: #5a8f3a;
            border: 2px solid #373737;
        }
        .book-cell {
            position: relative;
            aspect-ratio: 1;
            touch-action: pan-y;
            flex-shrink: 0;
            background: #8b8b8b;
            box-shadow: inset 2px 2px 0 #373737, inset -1px -1px 0 #fff;
            border: none;
            color: #fff;
            font-size: 8px;
            font-weight: bold;
            padding: 2px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            text-align: center;
            line-height: 1.05;
        }
        .book-cell .ico {
            position: absolute;
            top: 4px; left: 50%;
            transform: translateX(-50%);
            width: 16px; height: 16px;
            box-shadow: inset 1px 1px 0 rgba(255,255,255,0.35);
        }
        .book-cell.ok { outline: 2px solid #3d9a2a; }
        .book-cell.no { outline: 2px solid #8b2e2e; opacity: 0.55; }
        .book-cell.sel { outline: 2px solid #f1c40f; }
        #recipe-preview {
            margin-top: 5px;
            font-size: 11px;
            color: #333;
            min-height: 16px;
        }
        .prev-line { margin-bottom: 4px; }
        .prev-need { color: #333; }
        .prev-grid {
            display: inline-grid;
            gap: 2px;
            vertical-align: middle;
            margin-left: 4px;
        }
        .prev-grid span, .prev-grid img {
            width: 18px; height: 18px;
            background: #8b8b8b;
            box-shadow: inset 1px 1px 0 #373737;
            image-rendering: pixelated;
        }
        .book-acts {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 4px;
            margin-top: 6px;
        }
        .book-acts button {
            padding: 8px 4px;
            border: 2px solid #373737;
            background: #5a8f3a;
            color: #fff;
            font-weight: bold;
            font-size: 12px;
            box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #555;
        }
        .book-acts button.alt { background: #8b8b8b; }
        .book-acts button:disabled { opacity: 0.35; }
        .craft-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin: 4px 0 8px;
        }
        .craft-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .craft-grid { display: grid; gap: 2px; }
        .craft-grid.g2 { grid-template-columns: repeat(2, 40px); }
        .craft-grid.g3 { grid-template-columns: repeat(3, 40px); }
        .mc-slot, .craft-slot, .craft-out, .inv-slot {
            position: relative;
            background: #8b8b8b;
            box-shadow: inset 2px 2px 0 #373737, inset -2px -2px 0 #ffffff;
            border: none;
            border-radius: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            color: #fff;
            text-align: center;
            font-weight: bold;
            text-shadow: 1px 1px 0 #000;
        }
        .craft-slot, .mc-slot {
            width: 40px;
            height: 40px;
        }
        .craft-out {
            width: 48px;
            height: 48px;
        }
        .craft-result {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }
        .craft-all-btn {
            min-width: 48px;
            padding: 5px 6px;
            border: 2px solid #373737;
            background: #5a8f3a;
            color: #fff;
            font-weight: bold;
            font-size: 11px;
            box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #555;
        }
        .craft-arrow { color: #404040; font-size: 22px; font-weight: bold; }
        .furnace-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .furnace-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }
        .furnace-fire {
            font-size: 14px;
            line-height: 1;
            min-height: 16px;
        }
        #btn-book, #btn-book-3, #btn-book-f {
            width: 36px;
            height: 36px;
            border: 2px solid #373737;
            background: #8b5a2b;
            color: #f5e6c8;
            font-size: 18px;
            box-shadow: inset 1px 1px 0 #c48a4a;
            flex-shrink: 0;
        }
        #btn-book.on, #btn-book-3.on, #btn-book-f.on { background: #3d6e28; }
        #craft-book { display: none; }
        #inv-carry {
            text-align: left;
            font-size: 11px;
            color: #404040;
            font-family: monospace;
            margin: 0 0 6px 4px;
        }
        .inv-label {
            font-size: 11px;
            color: #404040;
            margin: 8px 2px 4px;
        }
        .inv-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 2px;
        }
        .inv-slot {
            aspect-ratio: 1;
            min-height: 38px;
        }
        .inv-slot.hot { outline: 1px solid #aa8822; }
        .inv-slot.active-hotbar { outline: 2px solid #f1c40f; }
        #inv-close {
            display: block;
            width: 100%;
            margin-top: 10px;
            padding: 8px;
            border: 2px solid #373737;
            border-radius: 0;
            background: #8b8b8b;
            color: #fff;
            font-weight: bold;
            font-size: 13px;
            box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #555;
        }
        #inv-hand {
            text-align: center;
            background: #8b8b8b;
            border: none;
            box-shadow: inset 2px 2px 0 #373737, inset -2px -2px 0 #fff;
            border-radius: 0;
            padding: 6px 8px;
            margin-bottom: 8px;
            font-size: 12px;
            font-weight: bold;
            min-height: 18px;
            color: #fff;
            text-shadow: 1px 1px 0 #000;
        }
        #inv-hand.empty { opacity: 0.7; }
        #inv-cursor-float {
            position: fixed;
            pointer-events: none;
            z-index: 95;
            display: none;
            min-width: 52px;
            min-height: 52px;
            padding: 4px;
            background: rgba(20, 20, 24, 0.92);
            border: 2px solid #5dade2;
            border-radius: 8px;
            color: #fff;
            font-size: 10px;
            font-weight: bold;
            text-align: center;
            transform: translate(-50%, -110%);
        }
        #inv-hint {
            text-align: center;
            font-size: 11px;
            color: #404040;
            margin: 8px 0 6px;
            min-height: 14px;
        }
        #inv-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px;
            margin-top: 8px;
        }
        #inv-actions button {
            padding: 7px 6px;
            border: 2px solid #373737;
            border-radius: 0;
            background: #8b8b8b;
            color: #fff;
            font-size: 12px;
            font-weight: bold;
            box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 #555;
        }
        #inv-actions button:disabled {
            opacity: 0.35;
        }
        #inv-toast {
            position: absolute;
            top: 58px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.75);
            color: #fff;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 13px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
            z-index: 90;
            white-space: nowrap;
        }
    </style>
    <!-- Three.js R128 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <canvas id="game-canvas"></canvas>
    <div id="crosshair"></div>
    <div id="damage-flash"></div>
    <div id="underwater-overlay"></div>
    
    <div id="stats">
        <div>FPS: 60 | Water: Classic</div>
        <div id="time-display">☀️ День: 02:00</div>
    </div>

    <div id="btn-fullscreen" title="Полный экран">
        <svg id="fs-icon-enter" viewBox="0 0 24 24">
            <polyline points="4 9 4 4 9 4"></polyline>
            <polyline points="20 9 20 4 15 4"></polyline>
            <polyline points="4 15 4 20 9 20"></polyline>
            <polyline points="20 15 20 20 15 20"></polyline>
        </svg>
        <svg id="fs-icon-exit" viewBox="0 0 24 24" style="display:none;">
            <polyline points="9 4 9 9 4 9"></polyline>
            <polyline points="15 4 15 9 20 9"></polyline>
            <polyline points="9 20 9 15 4 15"></polyline>
            <polyline points="15 20 15 15 20 15"></polyline>
        </svg>
    </div>

    <div id="btn-inventory" title="Инвентарь">
        <svg viewBox="0 0 24 24">
            <rect x="4" y="7" width="16" height="13" rx="2"></rect>
            <path d="M8 7 V6 a4 4 0 0 1 8 0 V7"></path>
            <path d="M9 12 h6"></path>
        </svg>
    </div>

    <div id="inv-overlay">
        <div id="inv-panel">
            <h2>Инвентарь</h2>
            <div id="inv-tabs">
                <button type="button" id="tab-inv" class="on">Инв.</button>
                <button type="button" id="tab-craft">Верстак</button>
                <button type="button" id="tab-furnace">Печь</button>
