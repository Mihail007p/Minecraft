    function findBookRecipe(id) {
        let rec = CRAFT_RECIPES.filter(function (r) { return r.id === id; })[0];
        if (rec) return rec;
        return SMELT_RECIPES.filter(function (r) { return r.id === id; })[0] || null;
    }

    function renderCraftBook() {
        const grid = document.getElementById('book-grid');
        if (!grid) return;
        grid.innerHTML = '';
        const q = (bookQuery || '').toLowerCase();
        const list = allBookRecipes();
        list.forEach(function (rec) {
            if (bookCat !== 'all' && rec.cat !== bookCat) return;
            const name = rec.name + ' ×' + rec.result.count;
            if (q && name.toLowerCase().indexOf(q) < 0 && (BLOCK_NAMES[rec.result.type] || '').toLowerCase().indexOf(q) < 0) return;
            const ok = canAffordRecipe(rec);
            if (bookCraftableOnly && !ok) return;
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'book-cell ' + (ok ? 'ok' : 'no') + (bookSelected === rec.id ? ' sel' : '');
            const canN = ok ? maxCraftable(rec) : 0;
            if (canN > 0) {
                const badge = document.createElement('span');
                badge.className = 'can-n';
                badge.textContent = String(canN);
                b.appendChild(badge);
            }
            if (ITEM_ICON[rec.result.type]) {
                const ico = document.createElement('img');
                ico.className = 'item-icon';
                ico.src = ITEM_ICON[rec.result.type];
                b.appendChild(ico);
            }
            const lab = document.createElement('span');
            lab.textContent = rec.name;
            lab.style.position = 'absolute';
            lab.style.bottom = '1px';
            lab.style.left = '0';
            lab.style.right = '0';
            b.appendChild(lab);
            const go = function (e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                bookSelected = rec.id;
                showRecipePreview(rec);
                renderCraftBook();
            };
            b.addEventListener('click', go);
            b.addEventListener('touchstart', go, { passive: false });
            grid.appendChild(b);
        });
        if (bookSelected) {
            const rec = findBookRecipe(bookSelected);
            if (rec) showRecipePreview(rec);
        }
    }

    function showRecipePreview(rec) {
        const box = document.getElementById('recipe-preview');
        if (!box) return;
        const need = recipeNeed(rec);
        const parts = [];
        for (const k in need) {
            const tp = Number(k);
            const have = countInvType(tp);
            const needN = need[k];
            parts.push((BLOCK_NAMES[tp] || '?') + ' ' + have + '/' + needN);
        }
        const can = maxCraftable(rec);
        let html = '<div class="prev-line"><b>' + rec.name + ' ×' + rec.result.count + '</b>' +
            (rec.in ? ' <i>(печь)</i>' : '') + ' · можно ' + can + '</div>';
        html += '<div class="prev-need">' + parts.join(' · ') + '</div>';
        if (rec.shape) {
            const w = rec.shape[0].length;
            html += '<div class="prev-grid" style="grid-template-columns:repeat(' + w + ',18px);margin:4px 0">';
            rec.shape.join('').split('').forEach(function (ch) {
                if (ch === '.') {
                    html += '<span></span>';
                } else {
                    const tp = rec.keys[ch];
                    const src = ITEM_ICON[tp];
                    if (src) html += '<img src="' + src + '" alt="">';
                    else html += '<span style="background:' + (ITEM_COLOR[tp] || '#666') + '"></span>';
                }
            });
            html += '</div>';
        }
        html += '<div class="book-acts">';
        html += '<button type="button" class="alt" data-book-act="fill">В сетку</button>';
        html += '<button type="button" data-book-act="one"' + (can < 1 ? ' disabled' : '') + '>1</button>';
        html += '<button type="button" data-book-act="all"' + (can < 1 ? ' disabled' : '') + '>Всё</button>';
        html += '</div>';
        box.innerHTML = html;
        box.querySelectorAll('[data-book-act]').forEach(function (btn) {
            const act = btn.getAttribute('data-book-act');
            const go = function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (act === 'fill') tryFillRecipe(rec);
                else if (act === 'one') craftRecipeTimes(rec, 1);
                else if (act === 'all') craftRecipeTimes(rec, Math.max(1, maxCraftable(rec)));
                showRecipePreview(rec);
                renderCraftBook();
            };
            btn.addEventListener('click', go);
            btn.addEventListener('touchstart', go, { passive: false });
        });
    }

