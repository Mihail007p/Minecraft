    function takeNeedFromInv(need) {
        for (const k in need) {
            let left = need[k];
            const tp = Number(k);
            while (left > 0) {
                if (!takeOneFromInv(tp)) return false;
                left--;
            }
        }
        return true;
    }

    function craftRecipeTimes(rec, times) {
        if (rec.in) {
            setInvTab('furnace');
            let n = 0;
            const limit = times == null ? 1 : times;
            while (n < limit && countInvType(rec.in) > 0) {
                if (furnaceFuelLeft <= 0) {
                    const fv = getFuelValue(furnaceFuel && furnaceFuel.type);
                    if (fv > 0 && !isSlotEmpty(furnaceFuel)) {
                        furnaceFuel.count--;
                        if (furnaceFuel.count <= 0) furnaceFuel = emptySlot();
                        furnaceFuelLeft = fv;
                    } else {
                        const fuels = [ITEM_CHARCOAL, BLOCK_WOOD, BLOCK_PLANKS, ITEM_STICK, BLOCK_LEAVES];
                        let burned = false;
                        for (let f = 0; f < fuels.length; f++) {
                            if (takeOneFromInv(fuels[f])) {
                                furnaceFuelLeft = getFuelValue(fuels[f]);
                                burned = true;
                                break;
                            }
                        }
                        if (!burned) {
                            if (n === 0) showInvToast('Нет топлива');
                            break;
                        }
                    }
                }
                takeOneFromInv(rec.in);
                giveCraftResult(rec.result.type, rec.result.count);
                furnaceFuelLeft--;
                n++;
            }
            if (n === 0) showInvToast('Мало ресурсов');
            else { saveInventory(); refreshInventoryUI(); }
            return;
        }
        const can = maxCraftable(rec);
        const n = Math.min(times == null ? 1 : times, can);
        if (n <= 0) {
            showInvToast('Мало ресурсов');
            return;
        }
        const need = recipeNeed(rec);
        for (let i = 0; i < n; i++) {
            takeNeedFromInv(need);
            if (!giveCraftResult(rec.result.type, rec.result.count)) break;
        }
        saveInventory();
        refreshInventoryUI();
    }

    function tryFillRecipe(rec) {
        if (rec.in) {
            setInvTab('furnace');
            if (countInvType(rec.in) <= 0) {
                showInvToast('Мало ресурсов');
                return;
            }
            if (!isSlotEmpty(furnaceIn) && furnaceIn.type !== rec.in) {
                showInvToast('Освободи вход печи');
                return;
            }
            const have = countInvType(rec.in);
            const room = isSlotEmpty(furnaceIn) ? STACK_SIZE : STACK_SIZE - furnaceIn.count;
            const mv = Math.min(have, room);
            for (let i = 0; i < mv; i++) takeOneFromInv(rec.in);
            if (isSlotEmpty(furnaceIn)) furnaceIn = { type: rec.in, count: mv };
            else furnaceIn.count += mv;
            saveInventory();
            refreshInventoryUI();
            return;
        }
        dumpCraftToInventory(false);
        if (!canAffordRecipe(rec)) {
            showInvToast('Мало ресурсов');
            refreshInventoryUI();
            return;
        }
        const slots = rec.size === 2 ? craft2 : craft3;
        const size = rec.size === 2 ? 2 : 3;
        if (rec.shapeless) {
            rec.shapeless.forEach(function (p) {
                for (let n = 0; n < p[1]; n++) {
                    for (let i = 0; i < slots.length; i++) {
                        if (isSlotEmpty(slots[i])) {
                            slots[i] = { type: p[0], count: 1 };
                            break;
                        }
                    }
                    takeOneFromInv(p[0]);
                }
            });
        } else {
            rec.shape.forEach(function (row, r) {
                row.split('').forEach(function (ch, c) {
                    if (ch === '.') return;
                    const type = rec.keys[ch];
                    slots[r * size + c] = { type: type, count: 1 };
                    takeOneFromInv(type);
                });
            });
        }
        if (rec.size === 3) setInvTab('craft');
        else setInvTab('inv');
        refreshInventoryUI();
    }

    function takeOneFromInv(type) {
        for (let i = 0; i < INV_SIZE; i++) {
            if (inventory[i].type === type && inventory[i].count > 0) {
                inventory[i].count--;
                if (inventory[i].count <= 0) inventory[i] = emptySlot();
                return true;
            }
        }
        return false;
    }

    function allBookRecipes() {
        if (invTab === 'furnace') return SMELT_RECIPES;
        return CRAFT_RECIPES;
