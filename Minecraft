            type === ITEM_BOAT || type === ITEM_GLASS_BOTTLE ||
            isToolItem(type) || isArmorItem(type);
    }
    function canPlaceType(type) {
        return type !== BLOCK_EMPTY && type !== BLOCK_WATER && !isNonBlockItem(type);
    }
    function isOpaque(type) {
        return type !== BLOCK_EMPTY && type !== BLOCK_WATER && type !== ITEM_WOOL &&
            !isNonBlockItem(type);
    }

    const MC_TEX = { tiles: new Array(32) };
    (function buildMcTextures() {
        function hash(x, y, s) {
            let n = Math.imul(x * 374761393 + y * 668265263 + s * 1274126177, 1597334677);
            n = (n ^ (n >>> 13)) >>> 0;
            return n;
        }
        function n01(x, y, s) { return (hash(x, y, s) % 1024) / 1024; }
        function fbm(x, y, s) {
            return n01(x, y, s) * 0.42 + n01(x >> 1, y >> 1, s + 17) * 0.32 + n01(x >> 2, y >> 2, s + 41) * 0.26;
        }
        function hexToRgb(hex) {
            const n = parseInt(hex.slice(1), 16);
            return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
        }
        function rgbToHex(r, g, b) {
            r = Math.max(0, Math.min(255, r | 0));
            g = Math.max(0, Math.min(255, g | 0));
            b = Math.max(0, Math.min(255, b | 0));
            return '#' + ((1 << 24) | (r << 16) | (g << 8) | b).toString(16).slice(1);
        }
        function mixHex(a, b, t) {
            const A = hexToRgb(a), B = hexToRgb(b);
            return rgbToHex(A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t, A[2] + (B[2] - A[2]) * t);
        }
        function shade(hex, k) {
            if (!hex || hex.charAt(0) !== '#') return hex;
            const A = hexToRgb(hex);
            return rgbToHex(A[0] * k, A[1] * k, A[2] * k);
        }
        function make(fill) {
            const t = new Array(1024);
            function s(x, y, c) {
                if (x >= 0 && y >= 0 && x < 32 && y < 32) t[y * 32 + x] = c;
            }
            fill(s, t);
            for (let i = 0; i < 1024; i++) if (!t[i]) t[i] = '#000000';
            return t;
        }
        function dirtCol(x, y) {
            const v = fbm(x, y, 21);
            let c = mixHex('#5a361c', '#b07848', v);
            c = mixHex(c, '#6e4524', n01(x, y, 22) * 0.35);
            if (n01(x, y, 23) > 0.93) c = mixHex(c, '#3a2410', 0.7);
            if (n01(x, y, 24) > 0.96) c = '#c49a6a';
            if (n01(x, y, 25) > 0.97) c = '#8a8a7a';
            return c;
        }
        function stoneCol(x, y) {
            const v = fbm(x, y, 33);
            let c = mixHex('#4a4a4a', '#b0b0b0', v);
            if (n01(x, y, 34) > 0.92) c = '#3a3a3a';
            if (n01(x, y, 35) > 0.96) c = '#d0d0d0';
            return c;
        }
        function plankCol(x, y) {
            const board = Math.floor(y / 8);
            const gy = y % 8;
            const grain = n01(x + board * 13, y, 6);
            let c = mixHex('#8a6230', '#e0c088', 0.35 + grain * 0.5);
            if (gy === 0) c = mixHex(c, '#f0d8a0', 0.45);
            if (gy === 7) c = '#5a3c18';
            if (gy === 6) c = mixHex(c, '#6b4423', 0.4);
            if (((x + board * 11) % 32) === 9 && gy > 0 && gy < 7) c = '#6b4423';
            if (n01(x, y, 61) > 0.97) c = '#4a3018';
            return c;
        }

        MC_TEX.tiles[0] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) {
                const v = fbm(x, y, 11);
                let c = mixHex('#1e4a0c', '#8fd64a', v);
                c = mixHex(c, '#3d7319', n01(x, y, 12) * 0.3);
                if (v > 0.78) c = mixHex(c, '#c8f06a', 0.35);
                if (v < 0.18) c = mixHex(c, '#5a361c', 0.45);
                if (n01(x, y, 13) > 0.94) c = '#2a5410';
                s(x, y, c);
            }
        });
        MC_TEX.tiles[1] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) s(x, y, dirtCol(x, y));
        });
        MC_TEX.tiles[2] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) s(x, y, dirtCol(x, y));
            for (let x = 0; x < 32; x++) {
                const h = 6 + (hash(x, 0, 44) % 5);
                for (let y = 0; y < h; y++) {
                    const v = fbm(x, y, 11);
                    s(x, y, mixHex('#2a5410', '#7cc63a', v));
                }
                s(x, h, mixHex('#3d7319', '#5a361c', 0.35));
                if (hash(x, 1, 55) & 1) s(x, h + 1, '#4e8c20');
            }
        });
        MC_TEX.tiles[3] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) s(x, y, stoneCol(x, y));
            for (let i = 0; i < 18; i++) {
                let x = hash(i, 2, 12) % 32, y = hash(i, 4, 13) % 32;
                const len = 3 + (hash(i, 5, 14) % 6);
                for (let k = 0; k < len; k++) {
                    s(x, y, '#2e2e2e');
                    x = (x + ((hash(i, k, 15) & 1) ? 1 : 0)) & 31;
                    y = (y + 1) & 31;
                }
            }
        });
        MC_TEX.tiles[4] = make(function (s) {
            for (let x = 0; x < 32; x++) {
                const band = Math.floor(x / 5);
                const gx = x % 5;
                for (let y = 0; y < 32; y++) {
                    const v = n01(band, y, 70);
                    let c = mixHex('#1a0e06', '#8a5a30', 0.25 + v * 0.55);
                    if (gx === 0) c = '#1a0e06';
                    if (gx === 1) c = mixHex(c, '#4a3018', 0.4);
                    if (n01(x, y, 71) > 0.92) c = '#c4a06a';
                    if (n01(x, y, 72) > 0.94) c = '#2a6418';
                    s(x, y, c);
                }
            }
        });
        MC_TEX.tiles[5] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) {
                const dx = x - 15.5, dy = y - 15.5, r = Math.sqrt(dx * dx + dy * dy);
                const grain = n01(x, y, 5) * 0.2;
                let c = mixHex('#c4a06a', '#8a6230', grain + (r % 3) / 8);
                if (r > 14.6) c = '#3d2814';
                else if (Math.abs(r - 12) < 0.9) c = '#5a3c18';
                else if (Math.abs(r - 8.5) < 0.8) c = '#6b4423';
                else if (Math.abs(r - 5) < 0.7) c = '#8a6230';
                else if (r < 2.2) c = '#3d2814';
                else c = mixHex('#e0c088', '#a07838', n01(x, y, 51) * 0.6);
                s(x, y, c);
            }
        });
        MC_TEX.tiles[6] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) s(x, y, plankCol(x, y));
        });
        MC_TEX.tiles[7] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) {
                const v = fbm(x, y, 77);
                if (n01(x, y, 78) > 0.88) s(x, y, '#0a1806');
                else s(x, y, mixHex('#14380c', '#6ad040', v));
            }
        });
        MC_TEX.tiles[8] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) {
                const v = fbm(x, y, 88);
                let c = mixHex('#c2b373', '#f5ecd0', v);
                if (n01(x, y, 89) > 0.93) c = '#a89860';
                if (n01(x, y, 90) > 0.97) c = '#8a7a48';
                s(x, y, c);
            }
        });
        MC_TEX.tiles[9] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) s(x, y, '#4a1814');
            for (let y = 6; y < 26; y++) for (let x = 4; x < 28; x++) {
                const v = fbm(x, y, 9);
                s(x, y, mixHex('#a03028', '#f09890', v));
            }
            for (let x = 6; x < 18; x++) for (let y = 8; y < 12; y++) s(x, y, mixHex('#f0c0b8', '#fff0e8', n01(x, y, 91)));
            for (let x = 8; x < 22; x++) s(x, 20, '#7a2820');
        });
        MC_TEX.tiles[10] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) {
                const v = fbm(x, y, 10);
                const knit = ((x >> 2) + (y >> 2)) & 1;
                let c = mixHex('#d0d0d0', '#ffffff', v);
                if (knit) c = mixHex(c, '#c4c4c4', 0.4);
                if (y % 8 === 0) c = mixHex(c, '#b0b0b0', 0.5);
                s(x, y, c);
            }
        });
        MC_TEX.tiles[11] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) {
                const w = Math.sin((x * 0.45) + Math.sin(y * 0.35) * 2.2);
                const c1 = w > 0 ? 'rgba(40, 105, 210, 0.55)' : 'rgba(22, 70, 170, 0.52)';
                s(x, y, c1);
            }
            for (let y = 4; y < 32; y += 5) {
                const ox = (y % 10 === 4) ? 0 : 3;
                for (let x = ox; x < 32; x += 6) s(x, y, 'rgba(150, 210, 255, 0.42)');
            }
        });
        MC_TEX.tiles[12] = make(function (s) {
            for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) s(x, y, mixHex('#bba57a', '#d4c4a0', n01(x, y, 12)));
            for (let y = 4; y < 28; y++) { s(15, y, '#8a6230'); s(16, y, '#c4a06a'); }
            for (let i = 0; i < 16; i++) {
                s(14 - (i >> 2), 6 + i, '#fff8ee');
                s(17 + (i >> 2), 7 + i, '#f5ead4');
                s(12 - (i >> 2), 8 + i, '#efe0c4');
