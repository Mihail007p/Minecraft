        e.preventDefault();
        const hit = raycastVoxel();
        if (hit.hit) {
            if (hit.isMob) {
                hit.mob.takeDamage(2);
            } else if (hit.block.y > 0) {
                spawnBlockDrop(hit.block.x, hit.block.y, hit.block.z, hit.blockType);
                setBlock(hit.block.x, hit.block.y, hit.block.z, BLOCK_EMPTY);
            }
        }
    });

    document.getElementById('btn-place').addEventListener('touchstart', (e) => {
        e.preventDefault();
        const currentSlot = inventory[selectedSlotIndex];
        if (!currentSlot || currentSlot.type === BLOCK_EMPTY || currentSlot.count <= 0) return;

        const heal = foodHeal(currentSlot.type);
        if (!canPlaceType(currentSlot.type) && !heal) return;

        if (heal) {
            if (player.health < player.maxHealth) {
                player.health = Math.min(player.maxHealth, player.health + heal);
                currentSlot.count--;
                if (currentSlot.count <= 0) currentSlot.type = BLOCK_EMPTY;
                saveInventory();
                refreshInventoryUI();
                updateHUD();
            }
            return;
        }

        const hit = raycastVoxel();
        if (hit.hit && !hit.isMob) {
            const p = hit.place;
            const pr = player.radius, ph = player.height;
            const intersectPlayer = (
                p.x + 1 > player.pos.x - pr && p.x < player.pos.x + pr &&
                p.y + 1 > player.pos.y && p.y < player.pos.y + ph &&
                p.z + 1 > player.pos.z - pr && p.z < player.pos.z + pr
            );

            if (!intersectPlayer) {
                setBlock(p.x, p.y, p.z, currentSlot.type);
                currentSlot.count--;
                if (currentSlot.count <= 0) currentSlot.type = BLOCK_EMPTY;
                saveInventory();
                refreshInventoryUI();
            }
        }
    });

