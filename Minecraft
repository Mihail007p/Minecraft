    function recipeNeed(rec) {
        const need = {};
        if (rec.in) {
            need[rec.in] = 1;
            return need;
        }
        if (rec.shapeless) {
            rec.shapeless.forEach(function (p) { need[p[0]] = (need[p[0]] || 0) + p[1]; });
        } else if (rec.shape) {
            rec.shape.join('').split('').forEach(function (ch) {
                if (ch !== '.' && rec.keys[ch]) need[rec.keys[ch]] = (need[rec.keys[ch]] || 0) + 1;
            });
        }
        return need;
    }

    function countInvType(type) {
        let n = 0;
        for (let i = 0; i < INV_SIZE; i++) {
            if (inventory[i] && inventory[i].type === type) n += inventory[i].count;
        }
        return n;
    }

    function canAffordRecipe(rec) {
        const need = recipeNeed(rec);
        for (const k in need) {
            if (countInvType(Number(k)) < need[k]) return false;
        }
        return Object.keys(need).length > 0;
    }

    function maxCraftable(rec) {
        const need = recipeNeed(rec);
        let m = Infinity;
        for (const k in need) {
            if (need[k] <= 0) continue;
            m = Math.min(m, Math.floor(countInvType(Number(k)) / need[k]));
        }
        return m === Infinity ? 0 : m;
    }

    function dropExtras(type, count) {
        if (count <= 0) return;
        if (typeof spawnBlockDrop === 'function' && typeof player !== 'undefined') {
            for (let i = 0; i < count; i++) {
                spawnBlockDrop(player.pos.x - 0.5, player.pos.y + 0.9, player.pos.z - 0.5, type);
            }
        }
    }

    function giveCraftResult(type, count) {
        let left = count;
        if (isSlotEmpty(cursorStack)) {
            const mv = Math.min(STACK_SIZE, left);
            cursorStack = { type: type, count: mv };
            left -= mv;
        } else if (cursorStack.type === type) {
            const mv = Math.min(STACK_SIZE - cursorStack.count, left);
            cursorStack.count += mv;
            left -= mv;
        } else {
            if (!addItemToInventory(type, left)) dropExtras(type, left);
            return false;
        }
        if (left > 0) {
            if (!addItemToInventory(type, left)) dropExtras(type, left);
        }
        return true;
    }

    function extractShape(slots, size) {
        let minR = size, maxR = -1, minC = size, maxC = -1;
        for (let r = 0; r < size; r++) {
            for (let c = 0; c < size; c++) {
                if (!isSlotEmpty(slots[r * size + c])) {
                    if (r < minR) minR = r;
                    if (r > maxR) maxR = r;
                    if (c < minC) minC = c;
                    if (c > maxC) maxC = c;
                }
            }
        }
        if (maxR < 0) return null;
        const rows = [];
        for (let r = minR; r <= maxR; r++) {
            let line = '';
            for (let c = minC; c <= maxC; c++) {
                const s = slots[r * size + c];
                line += isSlotEmpty(s) ? '.' : ('#' + s.type + ';');
            }
            rows.push(line);
        }
        return rows.join('|');
    }

    function recipeToExtract(shape, keys) {
        const h = shape.length, w = shape[0].length;
        const size = Math.max(h, w);
        const slots = [];
        for (let r = 0; r < size; r++) {
            for (let c = 0; c < size; c++) {
                if (r < h && c < w) {
                    const ch = shape[r].charAt(c);
                    slots.push(ch === '.' ? emptySlot() : { type: keys[ch], count: 1 });
                } else {
                    slots.push(emptySlot());
                }
            }
        }
        return extractShape(slots, size);
    }

    function mirrorShape(shape) {
        return shape.map(function (row) { return row.split('').reverse().join(''); });
    }

    function matchCraft(slots, size) {
        let used = 0;
        for (let i = 0; i < slots.length; i++) if (!isSlotEmpty(slots[i])) used++;
        if (!used) return null;

        for (let r = 0; r < CRAFT_RECIPES.length; r++) {
            const rec = CRAFT_RECIPES[r];
            if (rec.size > size) continue;
            if (rec.shapeless) {
                const have = {};
                let extra = 0;
                for (let i = 0; i < slots.length; i++) {
                    if (isSlotEmpty(slots[i])) continue;
                    have[slots[i].type] = (have[slots[i].type] || 0) + 1;
                    extra++;
                }
                let ok = true;
                let needSlots = 0;
                rec.shapeless.forEach(function (p) {
                    needSlots += p[1];
                    if ((have[p[0]] || 0) < p[1]) ok = false;
                });
                if (ok && extra === needSlots) return { type: rec.result.type, count: rec.result.count };
            } else {
                const got = extractShape(slots, size);
                if (!got) continue;
                const a = recipeToExtract(rec.shape, rec.keys);
                const b = recipeToExtract(mirrorShape(rec.shape), rec.keys);
                if (got === a || got === b) return { type: rec.result.type, count: rec.result.count };
            }
        }
        return null;
    }

    function consumeCraft(slots) {
        for (let i = 0; i < slots.length; i++) {
            if (isSlotEmpty(slots[i])) continue;
            slots[i].count--;
            if (slots[i].count <= 0) slots[i] = emptySlot();
        }
    }

    function handleCraftSlotTap(size, index) {
        const slots = getCraftSlots(size);
        if (!slots || index < 0 || index >= slots.length) return;
        const slot = slots[index];
        if (isSlotEmpty(cursorStack)) {
            if (isSlotEmpty(slot)) return;
            cursorStack = { type: slot.type, count: slot.count };
            slots[index] = emptySlot();
        } else if (isSlotEmpty(slot)) {
            slots[index] = { type: cursorStack.type, count: cursorStack.count };
            cursorStack = emptySlot();
        } else if (slot.type === cursorStack.type && slot.count < STACK_SIZE) {
            const move = Math.min(cursorStack.count, STACK_SIZE - slot.count);
            slot.count += move;
            cursorStack.count -= move;
            if (cursorStack.count <= 0) cursorStack = emptySlot();
        } else {
            const tmp = { type: slot.type, count: slot.count };
            slots[index] = { type: cursorStack.type, count: cursorStack.count };
            cursorStack = tmp;
        }
        refreshInventoryUI();
    }

    function handleCraftOutput(size, maxTimes) {
        const slots = getCraftSlots(size);
        const limit = maxTimes == null ? 1 : maxTimes;
        let crafted = 0;
        while (crafted < limit) {
            const rec = matchCraft(slots, size);
            if (!rec) break;
            if (isSlotEmpty(cursorStack)) {
                cursorStack = { type: rec.type, count: rec.count };
            } else if (cursorStack.type === rec.type && cursorStack.count + rec.count <= STACK_SIZE) {
                cursorStack.count += rec.count;
            } else {
                if (crafted === 0) showInvToast('Освободи руку');
                break;
            }
            consumeCraft(slots);
            crafted++;
        }
        if (crafted) refreshInventoryUI();
    }

    function dumpCraftToInventory(includeFurnace) {
        function dump(slots) {
            for (let i = 0; i < slots.length; i++) {
                if (isSlotEmpty(slots[i])) continue;
                if (!addItemToInventory(slots[i].type, slots[i].count)) {
                    if (typeof spawnBlockDrop === 'function' && typeof player !== 'undefined') {
                        for (let k = 0; k < slots[i].count; k++) {
                            spawnBlockDrop(player.pos.x - 0.5, player.pos.y + 0.9, player.pos.z - 0.5, slots[i].type);
                        }
                    }
                }
                slots[i] = emptySlot();
            }
        }
        dump(craft2);
        dump(craft3);
        if (includeFurnace !== false) {
            function dumpOne(obj, set) {
                if (isSlotEmpty(obj)) return;
                if (!addItemToInventory(obj.type, obj.count)) dropExtras(obj.type, obj.count);
                set(emptySlot());
            }
            dumpOne(furnaceIn, function (s) { furnaceIn = s; });
            dumpOne(furnaceFuel, function (s) { furnaceFuel = s; });
            dumpOne(furnaceOut, function (s) { furnaceOut = s; });
            furnaceFuelLeft = 0;
        }
    }

    function getFuelValue(type) {
        if (type === ITEM_CHARCOAL) return 8;
        if (type === ITEM_STICK) return 1;
        if (type === BLOCK_WOOD || type === BLOCK_PLANKS || type === BLOCK_CRAFT ||
            type === BLOCK_CHEST || type === BLOCK_BARREL || type === BLOCK_DOOR ||
            type === BLOCK_FENCE || type === BLOCK_GATE || type === BLOCK_TRAPDOOR ||
            type === BLOCK_SIGN || type === BLOCK_LADDER || type === ITEM_BOAT ||
            type === ITEM_BOWL || type === BLOCK_LOOM || type === BLOCK_SMITHING ||
            type === BLOCK_BED) return 2;
        if (type === BLOCK_LEAVES || type === ITEM_WOOD_PICK ||
            type === ITEM_WOOD_AXE || type === ITEM_WOOD_SWORD || type === ITEM_WOOD_SHOVEL ||
            type === ITEM_WOOD_HOE || type === BLOCK_CAMPFIRE) return 1;
        return 0;
    }

    function findSmelt(type) {
        for (let i = 0; i < SMELT_RECIPES.length; i++) {
            if (SMELT_RECIPES[i].in === type) return SMELT_RECIPES[i];
        }
        return null;
    }

    function swapCursorSlot(getter, setter) {
        const slot = getter();
        if (isSlotEmpty(cursorStack)) {
            if (isSlotEmpty(slot)) return;
            setter(emptySlot());
            cursorStack = { type: slot.type, count: slot.count };
        } else if (isSlotEmpty(slot)) {
            setter({ type: cursorStack.type, count: cursorStack.count });
            cursorStack = emptySlot();
        } else if (slot.type === cursorStack.type && slot.count < STACK_SIZE) {
            const move = Math.min(cursorStack.count, STACK_SIZE - slot.count);
            slot.count += move;
            cursorStack.count -= move;
            if (cursorStack.count <= 0) cursorStack = emptySlot();
            setter(slot);
        } else {
            setter({ type: cursorStack.type, count: cursorStack.count });
            cursorStack = { type: slot.type, count: slot.count };
        }
        refreshInventoryUI();
    }

    function handleFurnaceSlotTap(kind) {
        if (kind === 'out') {
            if (isSlotEmpty(furnaceOut)) return;
            if (isSlotEmpty(cursorStack)) {
                cursorStack = { type: furnaceOut.type, count: furnaceOut.count };
                furnaceOut = emptySlot();
            } else if (cursorStack.type === furnaceOut.type && cursorStack.count < STACK_SIZE) {
                const mv = Math.min(furnaceOut.count, STACK_SIZE - cursorStack.count);
                cursorStack.count += mv;
                furnaceOut.count -= mv;
                if (furnaceOut.count <= 0) furnaceOut = emptySlot();
            } else {
                showInvToast('Освободи руку');
                return;
            }
            refreshInventoryUI();
            return;
        }
        if (kind === 'in') swapCursorSlot(function () { return furnaceIn; }, function (s) { furnaceIn = s; });
        else if (kind === 'fuel') swapCursorSlot(function () { return furnaceFuel; }, function (s) { furnaceFuel = s; });
    }

    function smeltOnce(silent) {
        const rec = findSmelt(furnaceIn && furnaceIn.type);
        if (!rec || isSlotEmpty(furnaceIn)) {
            if (!silent) showInvToast('Нечего плавить');
            return false;
        }
        if (!isSlotEmpty(furnaceOut) && (furnaceOut.type !== rec.result.type || furnaceOut.count + rec.result.count > STACK_SIZE)) {
            if (!silent) showInvToast('Забери результат');
            return false;
        }
        if (furnaceFuelLeft <= 0) {
            const fv = getFuelValue(furnaceFuel && furnaceFuel.type);
            if (fv <= 0 || isSlotEmpty(furnaceFuel)) {
                if (!silent) showInvToast('Нет топлива');
                return false;
            }
            furnaceFuel.count--;
            if (furnaceFuel.count <= 0) furnaceFuel = emptySlot();
            furnaceFuelLeft = fv;
        }
        furnaceIn.count--;
        if (furnaceIn.count <= 0) furnaceIn = emptySlot();
        if (isSlotEmpty(furnaceOut)) furnaceOut = { type: rec.result.type, count: rec.result.count };
        else furnaceOut.count += rec.result.count;
        furnaceFuelLeft--;
        return true;
    }

