    // --- 2. ИНВЕНТАРЬ И СОХРАНЕНИЕ ---
    const HOTBAR_SIZE = 7;
    const BAG_SIZE = 21;
    const INV_SIZE = HOTBAR_SIZE + BAG_SIZE;
    const STACK_SIZE = 64;
    let selectedSlotIndex = 0;
    let inventory = [];
    let invOpen = false;
    let cursorStack = { type: 0, count: 0 };
    let craft2 = null;
    let craft3 = null;
    let invTab = 'inv';
    let furnaceIn = null;
    let furnaceFuel = null;
    let furnaceOut = null;
    let furnaceFuelLeft = 0;

    function emptySlot() { return { type: BLOCK_EMPTY, count: 0 }; }
    if (!craft2) craft2 = [emptySlot(), emptySlot(), emptySlot(), emptySlot()];
    if (!craft3) craft3 = [emptySlot(), emptySlot(), emptySlot(), emptySlot(), emptySlot(), emptySlot(), emptySlot(), emptySlot(), emptySlot()];
    if (!furnaceIn) furnaceIn = emptySlot();
    if (!furnaceFuel) furnaceFuel = emptySlot();
    if (!furnaceOut) furnaceOut = emptySlot();

    function isSlotEmpty(s) {
        return !s || s.type === BLOCK_EMPTY || s.count <= 0;
    }

    function normalizeInventory() {
        if (!Array.isArray(inventory)) inventory = [];
        for (let i = 0; i < inventory.length; i++) {
            const s = inventory[i];
            if (!s || typeof s.type !== 'number' || typeof s.count !== 'number' || s.count <= 0) {
                inventory[i] = emptySlot();
            } else {
                if (s.count > STACK_SIZE) s.count = STACK_SIZE;
            }
        }
        while (inventory.length < INV_SIZE) inventory.push(emptySlot());
        if (inventory.length > INV_SIZE) inventory.length = INV_SIZE;
    }

    function loadInventory() {
        try {
            const saved = localStorage.getItem('mc_pova_inventory_save');
            if (saved) inventory = JSON.parse(saved);
            else inventory = [];
        } catch (e) {
            inventory = [];
        }
        normalizeInventory();
    }

    function saveInventory() {
        try {
            localStorage.setItem('mc_pova_inventory_save', JSON.stringify(inventory));
        } catch (e) {}
    }

    function updateHotbarUI() {
        const hotbarEl = document.getElementById('hotbar');
        hotbarEl.innerHTML = '';

        for (let i = 0; i < HOTBAR_SIZE; i++) {
            const slot = inventory[i];
            const slotDiv = document.createElement('div');
            slotDiv.className = `slot ${i === selectedSlotIndex ? 'active' : ''}`;
            slotDiv.dataset.index = i;

            slotDiv.innerHTML = slotInnerHTML(slot);

            slotDiv.addEventListener('touchstart', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (invOpen) {
                    handleInvSlotTap(i);
                    return;
                }
                selectedSlotIndex = i;
                const slots = hotbarEl.querySelectorAll('.slot');
                for (let s = 0; s < slots.length; s++) {
                    slots[s].classList.toggle('active', s === selectedSlotIndex);
                }
            }, { passive: false });

            hotbarEl.appendChild(slotDiv);
        }
    }

    function getCarryInfo() {
        let used = 0, items = 0;
        for (let i = 0; i < INV_SIZE; i++) {
            const s = inventory[i];
            if (s && s.type !== BLOCK_EMPTY && s.count > 0) {
                used++;
                items += s.count;
            }
        }
        if (cursorStack && cursorStack.type !== BLOCK_EMPTY && cursorStack.count > 0) {
            used++;
            items += cursorStack.count;
        }
        return { used, items, slots: INV_SIZE, maxItems: INV_SIZE * STACK_SIZE };
    }

    function refreshInventoryUI() {
        updateHotbarUI();
        if (invOpen) updateInventoryPanel();
    }

    function addItemToInventory(type, amount = 1) {
        if (type === BLOCK_EMPTY || amount <= 0) return true;
        normalizeInventory();
        const before = amount;
        for (let i = 0; i < INV_SIZE && amount > 0; i++) {
            if (inventory[i].type === type && inventory[i].count < STACK_SIZE) {
                const toAdd = Math.min(STACK_SIZE - inventory[i].count, amount);
                inventory[i].count += toAdd;
                amount -= toAdd;
            }
        }
        for (let i = 0; i < INV_SIZE && amount > 0; i++) {
            if (isSlotEmpty(inventory[i])) {
                const toAdd = Math.min(STACK_SIZE, amount);
                inventory[i].type = type;
                inventory[i].count = toAdd;
                amount -= toAdd;
            }
        }
        if (amount !== before) {
            saveInventory();
            refreshInventoryUI();
        }
        if (amount > 0 && amount === before) showInvToast('Инвентарь полон');
        return amount === 0;
    }

    function slotInnerHTML(slot) {
        if (!slot || slot.type === BLOCK_EMPTY || slot.count <= 0) {
            return '';
        }
        const src = ITEM_ICON[slot.type];
        const name = BLOCK_NAMES[slot.type] || '';
        const img = src
            ? '<img class="item-icon" src="' + src + '" alt="' + name + '" title="' + name + '">'
            : '<span>' + name + '</span>';
        const cnt = slot.count > 1 ? '<span class="count-badge">' + slot.count + '</span>' : '';
        return img + cnt;
    }

    function updateInventoryPanel() {
        const carry = getCarryInfo();
        const carryEl = document.getElementById('inv-carry');
        if (carryEl) {
            carryEl.textContent = 'Слоты ' + carry.used + '/' + carry.slots + ' · Предметы ' + carry.items + '/' + carry.maxItems;
        }
        function fillInvGrid(hotId, bagId) {
            const hotGrid = document.getElementById(hotId);
            const bagGrid = document.getElementById(bagId);
            if (!hotGrid || !bagGrid) return;
            hotGrid.innerHTML = '';
            bagGrid.innerHTML = '';
            for (let i = 0; i < INV_SIZE; i++) {
                const slot = inventory[i];
                const el = document.createElement('div');
                el.className = 'inv-slot' + (i < HOTBAR_SIZE ? ' hot' : '');
                if (i === selectedSlotIndex) el.classList.add('active-hotbar');
                el.dataset.index = String(i);
                el.innerHTML = slotInnerHTML(slot);
                (i < HOTBAR_SIZE ? hotGrid : bagGrid).appendChild(el);
            }
        }
        fillInvGrid('inv-hotbar-grid', 'inv-bag-grid');
        const hand = document.getElementById('inv-hand');
        if (hand) {
            if (isSlotEmpty(cursorStack)) {
                hand.className = 'empty';
                hand.textContent = 'В руке: пусто';
            } else {
                hand.className = '';
                hand.textContent = 'В руке: ' + (BLOCK_NAMES[cursorStack.type] || 'Предмет') + ' × ' + cursorStack.count;
            }
        }
        const hint = document.getElementById('inv-hint');
        if (hint) {
            hint.textContent = isSlotEmpty(cursorStack) ? 'Нажми стак — возьмёшь его целиком' : 'Нажми пустую ячейку — положишь весь стак';
        }
        const flt = document.getElementById('inv-cursor-float');
        if (flt) {
            if (isSlotEmpty(cursorStack)) flt.style.display = 'none';
            else {
                flt.style.display = 'block';
                flt.innerHTML = slotInnerHTML(cursorStack);
            }
        }
        updateInvActionButtons();
        renderCraftGrids();
    }

    function showInvToast(msg) {
        const el = document.getElementById('inv-toast');
        if (!el) return;
        el.textContent = msg;
        el.style.opacity = '1';
        clearTimeout(showInvToast._t);
        showInvToast._t = setTimeout(function () { el.style.opacity = '0'; }, 1600);
    }

    function findEmptySlot(from, to) {
        for (let i = from; i < to; i++) {
            if (isSlotEmpty(inventory[i])) return i;
        }
        return -1;
    }

    function handleInvSlotTap(index) {
        normalizeInventory();
        if (index < 0 || index >= INV_SIZE) return;
        const slot = inventory[index];

        if (isSlotEmpty(cursorStack)) {
            if (isSlotEmpty(slot)) {
                if (index < HOTBAR_SIZE) selectedSlotIndex = index;
                refreshInventoryUI();
                return;
            }
            cursorStack = { type: slot.type, count: slot.count };
            inventory[index] = emptySlot();
            if (index < HOTBAR_SIZE) selectedSlotIndex = index;
            saveInventory();
            refreshInventoryUI();
            return;
        }

        if (isSlotEmpty(slot)) {
            inventory[index] = { type: cursorStack.type, count: cursorStack.count };
            cursorStack = emptySlot();
            if (index < HOTBAR_SIZE) selectedSlotIndex = index;
            saveInventory();
            refreshInventoryUI();
            return;
        }

        if (slot.type === cursorStack.type && slot.count < STACK_SIZE) {
            const move = Math.min(cursorStack.count, STACK_SIZE - slot.count);
            slot.count += move;
            cursorStack.count -= move;
            if (cursorStack.count <= 0) cursorStack = emptySlot();
            saveInventory();
            refreshInventoryUI();
            return;
        }

        const tmp = { type: slot.type, count: slot.count };
        inventory[index] = { type: cursorStack.type, count: cursorStack.count };
        cursorStack = tmp;
        if (index < HOTBAR_SIZE) selectedSlotIndex = index;
        saveInventory();
        refreshInventoryUI();
    }

    function splitHeldStack() {
        normalizeInventory();
        if (isSlotEmpty(cursorStack)) {
            showInvToast('Сначала возьми стак');
            return;
        }
        if (cursorStack.count < 2) {
            showInvToast('Нечего делить');
            return;
        }
        const dest = findEmptySlot(0, INV_SIZE);
        if (dest < 0) {
            showInvToast('Нет пустого слота');
            return;
        }
        const half = Math.floor(cursorStack.count / 2);
        inventory[dest] = { type: cursorStack.type, count: half };
        cursorStack.count -= half;
        saveInventory();
        refreshInventoryUI();
    }

    function dropFromInventory(_index, count) {
        normalizeInventory();
        if (isSlotEmpty(cursorStack)) {
            showInvToast('Сначала возьми предмет');
            return;
        }
        if (typeof spawnBlockDrop !== 'function' || typeof player === 'undefined') return;
        const n = Math.min(count, cursorStack.count);
        for (let i = 0; i < n; i++) {
            spawnBlockDrop(player.pos.x - 0.5, player.pos.y + 0.9, player.pos.z - 0.5, cursorStack.type);
        }
        cursorStack.count -= n;
        if (cursorStack.count <= 0) cursorStack = emptySlot();
        saveInventory();
        refreshInventoryUI();
        showInvToast(n === 1 ? 'Выброшено 1' : 'Выброшено ' + n);
    }

    function eatFromInventory() {
        normalizeInventory();
        const heal = isSlotEmpty(cursorStack) ? 0 : foodHeal(cursorStack.type);
        if (!heal) {
            showInvToast('Возьми еду в руку');
            return;
        }
        if (typeof player === 'undefined') return;
        if (player.health >= player.maxHealth) {
            showInvToast('Здоровье полное');
            return;
        }
        player.health = Math.min(player.maxHealth, player.health + heal);
        cursorStack.count--;
        if (cursorStack.count <= 0) cursorStack = emptySlot();
        if (typeof updateHUD === 'function') updateHUD();
        saveInventory();
        refreshInventoryUI();
    }

    function moveHeldToHotbar() {
        normalizeInventory();
        if (isSlotEmpty(cursorStack)) {
            showInvToast('Сначала возьми предмет');
            return;
        }
        let dest = findEmptySlot(0, HOTBAR_SIZE);
        if (dest < 0) dest = Math.max(0, Math.min(HOTBAR_SIZE - 1, selectedSlotIndex));
        handleInvSlotTap(dest);
    }

    function compactInventory() {
        normalizeInventory();
        for (let i = 0; i < INV_SIZE; i++) {
            if (isSlotEmpty(inventory[i])) continue;
            for (let j = i + 1; j < INV_SIZE; j++) {
                if (inventory[j].type === inventory[i].type && inventory[i].count < STACK_SIZE) {
                    const move = Math.min(inventory[j].count, STACK_SIZE - inventory[i].count);
                    inventory[i].count += move;
                    inventory[j].count -= move;
                    if (inventory[j].count <= 0) inventory[j] = emptySlot();
                }
            }
        }
        const packed = [];
        for (let i = HOTBAR_SIZE; i < INV_SIZE; i++) {
            if (!isSlotEmpty(inventory[i])) packed.push(inventory[i]);
        }
        while (packed.length < BAG_SIZE) packed.push(emptySlot());
        for (let i = 0; i < BAG_SIZE; i++) inventory[HOTBAR_SIZE + i] = packed[i];
        saveInventory();
        refreshInventoryUI();
        showInvToast('Стаки сложены');
    }

    function updateInvActionButtons() {
        const has = !isSlotEmpty(cursorStack);
        const setDis = function (id, off) {
            const el = document.getElementById(id);
