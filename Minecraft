        setDis('inv-btn-split', !has || cursorStack.count < 2);
        setDis('inv-btn-drop1', !has);
        setDis('inv-btn-dropall', !has);
        setDis('inv-btn-eat', !has || !foodHeal(cursorStack.type));
        setDis('inv-btn-equip', !has);
    }

