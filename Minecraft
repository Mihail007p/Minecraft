    // --- 3. ШУМ ПЕРЛИНА ---
    const PERM = new Uint8Array(512);
    (function initNoise() {
        const p = [151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,140,36,103,30,69,142,
        8,99,37,240,21,10,23,190,6,148,247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,
        57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,74,165,71,134,139,48,27,166,
        77,146,158,231,83,111,229,122,60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,
        65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,200,196,135,130,116,188,159,86,
        164,100,109,198,173,186,3,64,52,217,220,246,155,147,205,178,160,149,150,157,212,126,224,
        22,238,206,104,183,153,141,197,243,182,144,170,12,176,167,115,214,134,163,162,138,227];
        for (let i = 0; i < 256; i++) {
            PERM[i] = p[i % p.length];
            PERM[i + 256] = PERM[i];
        }
    })();

    function fade(t) { return t * t * t * (t * (t * 6 - 15) + 10); }
    function lerp(t, a, b) { return a + t * (b - a); }
    function grad2D(hash, x, y) {
        const h = hash & 7;
        const u = h < 4 ? x : y, v = h < 4 ? y : x;
        return ((h & 1) ? -u : u) + ((h & 2) ? -2.0 * v : 2.0 * v);
    }
    function perlin2D(x, y) {
        const X = Math.floor(x) & 255, Y = Math.floor(y) & 255;
        const xf = x - Math.floor(x), yf = y - Math.floor(y);
        const u = fade(xf), v = fade(yf);
        const aa = PERM[PERM[X] + Y], ab = PERM[PERM[X] + Y + 1];
        const ba = PERM[PERM[X + 1] + Y], bb = PERM[PERM[X + 1] + Y + 1];
        return lerp(v,
            lerp(u, grad2D(aa, xf, yf), grad2D(ba, xf - 1, yf)),
            lerp(u, grad2D(ab, xf, yf - 1), grad2D(bb, xf - 1, yf - 1))
        );
    }
    function fbm(x, y) {
        let total = 0, amp = 1, freq = 1, maxAmp = 0;
        for (let i = 0; i < 3; i++) {
            total += perlin2D(x * freq, y * freq) * amp;
            maxAmp += amp; amp *= 0.5; freq *= 2.0;
        }
        return total / maxAmp;
    }
    function pseudoHash2D(x, z) {
        let h = (x * 374761393 + z * 668265263) ^ 0x5bf03635;
        h = (h ^ (h >> 13)) * 1274126177;
        return (h ^ (h >> 16)) >>> 0;
    }

    // --- 4. ТЕКСТУРНЫЙ АТЛАС (С классической текстурой воды) ---
    function createTextureAtlas() {
        const canvas = document.createElement('canvas');
        canvas.width = 128; canvas.height = 256;
        const ctx = canvas.getContext('2d');
        ctx.imageSmoothingEnabled = false;
        for (let id = 0; id < 32; id++) {
            const tile = MC_TEX.tiles[id];
            if (!tile) continue;
            const ox = (id % 4) * 32, oy = Math.floor(id / 4) * 32;
            for (let y = 0; y < 32; y++) {
                for (let x = 0; x < 32; x++) {
                    ctx.fillStyle = tile[y * 32 + x];
                    ctx.fillRect(ox + x, oy + y, 1, 1);
                }
            }
        }
        const texture = new THREE.CanvasTexture(canvas);
        texture.magFilter = THREE.NearestFilter;
        texture.minFilter = THREE.NearestFilter;
        texture.generateMipmaps = false;
        return texture;
    }

    function getTileUV(tileId) {
        const col = tileId % 4, row = Math.floor(tileId / 4);
        const uSize = 0.25, vSize = 0.125;
        return { u0: col * uSize, v0: 1.0 - (row + 1) * vSize, u1: col * uSize + uSize, v1: 1.0 - row * vSize };
    }

    function getBlockFaceTile(blockType, faceIndex) {
        if (blockType === BLOCK_GRASS) return faceIndex === 2 ? 0 : (faceIndex === 3 ? 1 : 2);
        if (blockType === BLOCK_DIRT) return 1;
        if (blockType === BLOCK_STONE) return 3;
        if (blockType === BLOCK_WOOD) return (faceIndex === 2 || faceIndex === 3) ? 5 : 4;
        if (blockType === BLOCK_PLANKS) return 6;
        if (blockType === BLOCK_LEAVES) return 7;
        if (blockType === BLOCK_SAND) return 8;
        if (blockType === ITEM_MEAT || blockType === ITEM_COOKED_MEAT || blockType === ITEM_STEW) return 9;
        if (blockType === ITEM_WOOL || blockType === BLOCK_CARPET || isArmorItem(blockType)) return 10;
        if (blockType === BLOCK_WATER) return 11;
        if (blockType === ITEM_FEATHER) return 12;
        if (blockType === ITEM_STICK || blockType === ITEM_STRING) return 13;
        if (blockType === BLOCK_CRAFT) return 14;
        if (blockType === BLOCK_TORCH) return 16;
        if (blockType === BLOCK_CHEST) return 17;
        if (blockType === BLOCK_FURNACE) return (faceIndex === 4 || faceIndex === 5) ? 18 : 19;
        if (blockType === BLOCK_SANDSTONE || blockType === BLOCK_CUT_SANDSTONE) return 20;
        if (blockType === BLOCK_GLASS || blockType === ITEM_GLASS_BOTTLE) return 21;
        if (blockType === BLOCK_DOOR) return 22;
        if (blockType === BLOCK_LADDER) return 23;
        if (blockType === BLOCK_FENCE || blockType === BLOCK_GATE) return 24;
        if (blockType === BLOCK_BED) return 25;
        if (blockType === BLOCK_TRAPDOOR) return 26;
        if (blockType === BLOCK_SIGN || blockType === BLOCK_PLATE || blockType === BLOCK_BUTTON) return 6;
        if (blockType === BLOCK_STONE_BRICK || blockType === BLOCK_WALL) return 27;
        if (blockType === BLOCK_SMOOTH_STONE) return 28;
        if (blockType === BLOCK_CAMPFIRE) return 29;
