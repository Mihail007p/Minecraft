    let lookTouchId = null, lastLookPos = { x: 0, y: 0 };

    function touchHitsRect(touch, el, pad) {
        if (!el) return false;
        const r = el.getBoundingClientRect();
        const p = pad || 8;
        return touch.clientX >= r.left - p && touch.clientX <= r.right + p &&
               touch.clientY >= r.top - p && touch.clientY <= r.bottom + p;
    }

    function isHudTouch(touch) {
        if (invOpen) return true;
        if (touchHitsRect(touch, document.getElementById('hotbar'), 12)) return true;
        if (touchHitsRect(touch, document.getElementById('btn-fullscreen'), 8)) return true;
        if (touchHitsRect(touch, document.getElementById('btn-inventory'), 8)) return true;
        if (touchHitsRect(touch, document.getElementById('respawn-btn'), 8)) return true;
        if (touchHitsRect(touch, document.querySelector('.btn-group'), 8)) return true;
        const t = touch.target;
        if (!t || !t.closest) return false;
        return !!(t.closest('#hotbar') || t.closest('.slot') || t.closest('.action-btn') ||
                  t.closest('#respawn-btn') || t.closest('#btn-fullscreen') || t.closest('#btn-inventory') ||
                  t.closest('#inv-overlay') || t.closest('#death-screen'));
    }

    window.addEventListener('touchstart', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const touch = e.changedTouches[i];
            if (isHudTouch(touch)) continue;

            if (touch.clientX < window.innerWidth * 0.45 && joystickTouchId === null) {
                joystickTouchId = touch.identifier;
                const rect = joystickZone.getBoundingClientRect();
                joystickCenter = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
                updateJoystick(touch.clientX, touch.clientY);
            } else if (touch.clientX >= window.innerWidth * 0.45 && lookTouchId === null) {
                lookTouchId = touch.identifier;
                lastLookPos = { x: touch.clientX, y: touch.clientY };
            }
        }
    }, { passive: false });

    window.addEventListener('touchmove', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const touch = e.changedTouches[i];
            if (touch.identifier === joystickTouchId) {
                updateJoystick(touch.clientX, touch.clientY);
            } else if (touch.identifier === lookTouchId) {
                const dx = touch.clientX - lastLookPos.x;
                const dy = touch.clientY - lastLookPos.y;
                lastLookPos = { x: touch.clientX, y: touch.clientY };

                player.yaw -= dx * 0.005;
                player.pitch -= dy * 0.005;
                player.pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, player.pitch));
            }
        }
    }, { passive: false });

    function resetJoystick() {
        joystickTouchId = null;
