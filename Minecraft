    function updatePhysics(dt) {
        if (player.isDead) return;

        if (player.spawnProtect > 0) {
            player.spawnProtect = Math.max(0, player.spawnProtect - dt);
            player.highestFallY = player.pos.y;
        }

        const feetBlock = getBlock(Math.floor(player.pos.x), Math.floor(player.pos.y), Math.floor(player.pos.z));
        const eyeBlock = getBlock(Math.floor(player.pos.x), Math.floor(player.pos.y + player.eyeHeight), Math.floor(player.pos.z));
        
        player.isInWater = (feetBlock === BLOCK_WATER || eyeBlock === BLOCK_WATER);
        player.isUnderwater = (eyeBlock === BLOCK_WATER);

        if (player.isUnderwater) {
            underwaterOverlay.style.opacity = '1';
            player.oxygen = Math.max(0, player.oxygen - dt * 1.0);
            if (player.oxygen <= 0) {
                player.drownTimer += dt;
                if (player.drownTimer >= 1.0) {
                    applyDamage(2);
                    player.drownTimer = 0;
                }
            }
        } else {
            underwaterOverlay.style.opacity = '0';
            player.oxygen = Math.min(player.maxOxygen, player.oxygen + dt * 10.0);
            player.drownTimer = 0;
        }
        updateHUD();

        if (player.isInWater) {
            player.vel.y -= 4.0 * dt;
            player.vel.y = Math.max(player.vel.y, -3.2);
            player.highestFallY = player.pos.y;
        } else {
            player.vel.y -= 24.0 * dt;
            if (player.vel.y < 0 && player.pos.y > player.highestFallY) {
                player.highestFallY = player.pos.y;
            }
        }

        let collidedX = false;
        let collidedZ = false;

        player.pos.x += player.vel.x * dt;
        if (checkSolidCollision(player.pos.x, player.pos.y, player.pos.z)) {
            player.pos.x -= player.vel.x * dt;
            collidedX = true;
        }

        player.pos.z += player.vel.z * dt;
        if (checkSolidCollision(player.pos.x, player.pos.y, player.pos.z)) {
            player.pos.z -= player.vel.z * dt;
            collidedZ = true;
        }

        const isMoving = (Math.abs(moveInput.x) > 0.1 || Math.abs(moveInput.y) > 0.1);
        if ((collidedX || collidedZ) && player.onGround && !player.isInWater && isMoving) {
            const stepY = player.pos.y + 1.15;
            const stepForwardX = player.pos.x + player.vel.x * dt * 2.5;
            const stepForwardZ = player.pos.z + player.vel.z * dt * 2.5;

            if (!checkSolidCollision(player.pos.x, stepY, player.pos.z) &&
                !checkSolidCollision(stepForwardX, stepY, stepForwardZ)) {
                player.vel.y = 8.2;
                player.onGround = false;
            }
        }

        player.pos.y += player.vel.y * dt;
        if (checkSolidCollision(player.pos.x, player.pos.y, player.pos.z)) {
            if (player.vel.y < 0) {
                const fallDistance = player.highestFallY - player.pos.y;
                if (fallDistance > 4.0 && !player.isInWater && player.spawnProtect <= 0) {
                    const dmg = Math.floor((fallDistance - 3.5) * 2.0);
                    if (dmg > 0) applyDamage(dmg);
                }
                player.onGround = true;
                player.highestFallY = player.pos.y;
            }
            player.pos.y -= player.vel.y * dt;
            player.vel.y = 0;
        } else {
            player.onGround = false;
        }

        camera.position.set(player.pos.x, player.pos.y + player.eyeHeight, player.pos.z);
        const euler = new THREE.Euler(0, 0, 0, 'YXZ');
        euler.x = player.pitch;
        euler.y = player.yaw;
        camera.quaternion.setFromEuler(euler);
    }

    // --- 10. СМЕНА ДНЯ И НОЧИ ---
    const DAY_DURATION = 120.0;
    const NIGHT_DURATION = 60.0;
    const TOTAL_CYCLE = 180.0;
    let cycleTimer = 0.0;
    const timeDisplay = document.getElementById('time-display');

    function updateDayNightCycle(dt) {
        cycleTimer = (cycleTimer + dt) % TOTAL_CYCLE;
        let celestialAngle = 0, isDay = (cycleTimer < DAY_DURATION);

        if (isDay) {
            celestialAngle = (cycleTimer / DAY_DURATION) * Math.PI;
            const rem = Math.ceil(DAY_DURATION - cycleTimer);
            timeDisplay.innerText = `☀️ День: ${String(Math.floor(rem / 60)).padStart(2, '0')}:${String(rem % 60).padStart(2, '0')}`;
        } else {
            celestialAngle = Math.PI + ((cycleTimer - DAY_DURATION) / NIGHT_DURATION) * Math.PI;
            const rem = Math.ceil(TOTAL_CYCLE - cycleTimer);
            timeDisplay.innerText = `🌙 Ночь: ${String(Math.floor(rem / 60)).padStart(2, '0')}:${String(rem % 60).padStart(2, '0')}`;
        }

        const orbitRadius = 60.0;
        const sunX = Math.cos(celestialAngle) * orbitRadius;
        const sunY = Math.sin(celestialAngle) * orbitRadius;
        const sunZ = 20.0;

        celestialGroup.position.copy(camera.position);
        sunMesh.position.set(sunX, sunY, sunZ);
        moonMesh.position.set(-sunX, -sunY, -sunZ);
        sunMesh.lookAt(camera.position);
        moonMesh.lookAt(camera.position);

        const sunHeight = Math.sin(celestialAngle);
        const dayFactor = Math.max(0.0, Math.min(1.0, (sunHeight + 0.15) / 0.35));
        const nightFactor = 1.0 - dayFactor;

        const daySky = new THREE.Color(0x78B5E8);
        const sunsetSky = new THREE.Color(0xd66847);
        const nightSky = new THREE.Color(0x04081c);

        let currentSky = new THREE.Color();
        if (sunHeight > 0.15) {
            currentSky.copy(daySky);
        } else if (sunHeight > -0.15) {
            currentSky.lerpColors(sunsetSky, daySky, (sunHeight + 0.15) / 0.3);
        } else {
            currentSky.lerpColors(nightSky, sunsetSky, Math.max(0.0, (sunHeight + 0.4) / 0.25));
        }

        if (!player.isUnderwater) {
            scene.background = currentSky;
            scene.fog.color = currentSky;
        }

        ambientLight.intensity = THREE.MathUtils.lerp(0.12, 0.72, dayFactor);
        ambientLight.color.lerpColors(new THREE.Color(0x6085ba), new THREE.Color(0xffffff), dayFactor);

        celestialLight.intensity = THREE.MathUtils.lerp(0.35, 0.65, dayFactor);
        celestialLight.color.lerpColors(new THREE.Color(0xaec8f5), new THREE.Color(0xfffae0), dayFactor);

        StarShader.uniforms.uOpacity.value = Math.max(0.0, nightFactor * 1.2 - 0.2);
        starField.position.copy(camera.position);

        if (cloudsMesh) {
            cloudsMesh.material.color.lerpColors(new THREE.Color(0x24324f), new THREE.Color(0xffffff), dayFactor);
        }

        const activeLightDir = (sunHeight >= 0) ? new THREE.Vector3(sunX, sunY, sunZ).normalize() : new THREE.Vector3(-sunX, -sunY, -sunZ).normalize();
        celestialLight.position.copy(activeLightDir);
    }

    // --- 11. 3D DDA RAYCASTING И ТАРГЕТ МОБОВ ---
    function raycastVoxel(maxDist = 5.5) {
        const origin = new THREE.Vector3(player.pos.x, player.pos.y + player.eyeHeight, player.pos.z);
        const dir = new THREE.Vector3(
            -Math.sin(player.yaw) * Math.cos(player.pitch),
            Math.sin(player.pitch),
            -Math.cos(player.yaw) * Math.cos(player.pitch)
        ).normalize();

        let closestMob = null;
        let closestMobDist = maxDist;

        for (let mob of mobs) {
            const mobCenter = mob.pos.clone().add(new THREE.Vector3(0, mob.height * 0.5, 0));
            const toMob = mobCenter.clone().sub(origin);
            const proj = toMob.dot(dir);

            if (proj > 0 && proj < maxDist) {
                const perpDist = toMob.clone().sub(dir.clone().multiplyScalar(proj)).length();
                if (perpDist < mob.radius + 0.35 && proj < closestMobDist) {
                    closestMob = mob;
                    closestMobDist = proj;
                }
            }
        }

        if (closestMob) {
            return { hit: true, isMob: true, mob: closestMob };
        }

        let x = Math.floor(origin.x), y = Math.floor(origin.y), z = Math.floor(origin.z);
        const stepX = Math.sign(dir.x), stepY = Math.sign(dir.y), stepZ = Math.sign(dir.z);

        const tDeltaX = dir.x !== 0 ? Math.abs(1 / dir.x) : 1e30;
        const tDeltaY = dir.y !== 0 ? Math.abs(1 / dir.y) : 1e30;
        const tDeltaZ = dir.z !== 0 ? Math.abs(1 / dir.z) : 1e30;

        let tMaxX = dir.x > 0 ? (x + 1 - origin.x) * tDeltaX : (origin.x - x) * tDeltaX;
        let tMaxY = dir.y > 0 ? (y + 1 - origin.y) * tDeltaY : (origin.y - y) * tDeltaY;
        let tMaxZ = dir.z > 0 ? (z + 1 - origin.z) * tDeltaZ : (origin.z - z) * tDeltaZ;

        let normal = { x: 0, y: 0, z: 0 };
        let dist = 0;

        while (dist < maxDist) {
            const b = getBlock(x, y, z);
            if (b !== BLOCK_EMPTY) {
                return {
                    hit: true,
                    isMob: false,
                    block: { x, y, z },
                    blockType: b,
                    place: { x: x + normal.x, y: y + normal.y, z: z + normal.z }
                };
            }

            if (tMaxX < tMaxY) {
                if (tMaxX < tMaxZ) {
                    x += stepX; dist = tMaxX; tMaxX += tDeltaX; normal = { x: -stepX, y: 0, z: 0 };
                } else {
                    z += stepZ; dist = tMaxZ; tMaxZ += tDeltaZ; normal = { x: 0, y: 0, z: -stepZ };
                }
            } else {
                if (tMaxY < tMaxZ) {
                    y += stepY; dist = tMaxY; tMaxY += tDeltaY; normal = { x: 0, y: -stepY, z: 0 };
                } else {
                    z += stepZ; dist = tMaxZ; tMaxZ += tDeltaZ; normal = { x: 0, y: 0, z: -stepZ };
                }
            }
        }
        return { hit: false };
    }

    // --- 12. СЕНСОРНОЕ УПРАВЛЕНИЕ ---
    const joystickZone = document.getElementById('joystick-zone');
    const joystickKnob = document.getElementById('joystick-knob');
    let joystickTouchId = null, joystickCenter = { x: 0, y: 0 }, moveInput = { x: 0, y: 0 };
    let lookTouchId = null, lastLookPos = { x: 0, y: 0 };

    function touchHitsRect(touch, el, pad) {
        if (!el) return false;
        const r = el.getBoundingClientRect();
        const p = pad || 8;
        return touch.clientX >= r.left - p && touch.clientX <= r.right + p &&
               touch.clientY >= r.top - p && touch.clientY <= r.bottom + p;
    }

    function isHudTouch(touch) {
        if (invOpen) return true;
        if (touchHitsRect(touch, document.getElementById('hotbar'), 12)) return true;
        if (touchHitsRect(touch, document.getElementById('btn-fullscreen'), 8)) return true;
        if (touchHitsRect(touch, document.getElementById('btn-inventory'), 8)) return true;
        if (touchHitsRect(touch, document.getElementById('respawn-btn'), 8)) return true;
        if (touchHitsRect(touch, document.querySelector('.btn-group'), 8)) return true;
        const t = touch.target;
        if (!t || !t.closest) return false;
        return !!(t.closest('#hotbar') || t.closest('.slot') || t.closest('.action-btn') ||
                  t.closest('#respawn-btn') || t.closest('#btn-fullscreen') || t.closest('#btn-inventory') ||
                  t.closest('#inv-overlay') || t.closest('#death-screen'));
    }

    window.addEventListener('touchstart', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const touch = e.changedTouches[i];
            if (isHudTouch(touch)) continue;

            if (touch.clientX < window.innerWidth * 0.45 && joystickTouchId === null) {
                joystickTouchId = touch.identifier;
                const rect = joystickZone.getBoundingClientRect();
                joystickCenter = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
                updateJoystick(touch.clientX, touch.clientY);
            } else if (touch.clientX >= window.innerWidth * 0.45 && lookTouchId === null) {
                lookTouchId = touch.identifier;
                lastLookPos = { x: touch.clientX, y: touch.clientY };
            }
        }
    }, { passive: false });

    window.addEventListener('touchmove', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const touch = e.changedTouches[i];
            if (touch.identifier === joystickTouchId) {
                updateJoystick(touch.clientX, touch.clientY);
            } else if (touch.identifier === lookTouchId) {
                const dx = touch.clientX - lastLookPos.x;
                const dy = touch.clientY - lastLookPos.y;
                lastLookPos = { x: touch.clientX, y: touch.clientY };

                player.yaw -= dx * 0.005;
                player.pitch -= dy * 0.005;
                player.pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, player.pitch));
            }
        }
    }, { passive: false });

    function resetJoystick() {
        joystickTouchId = null;
        moveInput = { x: 0, y: 0 };
        joystickKnob.style.transform = `translate(0px, 0px)`;
    }

    function onTouchRelease(e) {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const touch = e.changedTouches[i];
            if (touch.identifier === joystickTouchId) resetJoystick();
            if (touch.identifier === lookTouchId) lookTouchId = null;
        }
    }
    window.addEventListener('touchend', onTouchRelease);
    window.addEventListener('touchcancel', onTouchRelease);

    function updateJoystick(clientX, clientY) {
        const maxDist = 45;
        let dx = clientX - joystickCenter.x, dy = clientY - joystickCenter.y;
        const dist = Math.hypot(dx, dy);

        if (dist > maxDist) {
            dx = (dx / dist) * maxDist;
            dy = (dy / dist) * maxDist;
        }
        joystickKnob.style.transform = `translate(${dx}px, ${dy}px)`;
        moveInput.x = dx / maxDist;
        moveInput.y = -dy / maxDist;
    }

